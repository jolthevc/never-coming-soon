{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Never Coming Soon Duplicate Audit",
  "type": "object",
  "required": ["idea_id", "status", "similar_ideas", "judgment"],
  "properties": {
    "idea_id": {"type": "string"},
    "status": {"type": "string", "enum": ["CLEAR", "OVERLAP", "DUPLICATE"]},
    "similar_ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["idea_id", "similarity", "reason"],
        "properties": {
          "idea_id": {"type": "string"},
          "similarity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "judgment": {"type": "string"}
  },
  "additionalProperties": false
}
