{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Never Coming Soon Concept Intake",
  "type": "object",
  "required": ["seed"],
  "properties": {
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_title",
        "format",
        "genre",
        "premise",
        "creative_kernel",
        "why_exciting",
        "initial_possibilities",
        "creative_tags",
        "normalized_signature"
      ],
      "properties": {
        "working_title": {"type": "string", "minLength": 1},
        "format": {"type": "string", "enum": ["FILM", "SERIES", "LIMITED_SERIES"]},
        "genre": {"type": "string", "minLength": 1},
        "premise": {"type": "string", "minLength": 1},
        "creative_kernel": {"type": "string", "minLength": 1},
        "why_exciting": {"type": "string", "minLength": 1},
        "initial_possibilities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {"type": "string", "minLength": 1}
        },
        "creative_tags": {
          "type": "object",
          "required": ["secondary_genre", "arena", "tone", "era", "setting", "scale", "audience", "narrative_engine"],
          "properties": {
            "secondary_genre": {"type": ["string", "null"]},
            "arena": {"type": ["string", "null"]},
            "tone": {"type": "array", "items": {"type": "string"}},
            "era": {"type": ["string", "null"]},
            "setting": {"type": ["string", "null"]},
            "scale": {"type": ["string", "null"]},
            "audience": {"type": ["string", "null"]},
            "narrative_engine": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "normalized_signature": {
          "type": "object",
          "required": ["format", "genre", "arena", "protagonist_archetype", "central_relationship", "core_situation", "story_engine", "setting"],
          "properties": {
            "format": {"type": ["string", "null"]},
            "genre": {"type": ["string", "null"]},
            "arena": {"type": ["string", "null"]},
            "protagonist_archetype": {"type": ["string", "null"]},
            "central_relationship": {"type": ["string", "null"]},
            "core_situation": {"type": ["string", "null"]},
            "story_engine": {"type": ["string", "null"]},
            "setting": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}