{
  "title": "NCS Dashboard Ideation Request",
  "type": "object",
  "required": ["run_type"],
  "properties": {
    "run_type": {"type": "string", "enum": ["GENERAL", "DIRECTED", "CONCEPT_INTAKE"]},
    "target_seed_count": {"type": "integer", "minimum": 1, "default": 30},
    "human_direction": {"type": ["string", "null"]},
    "concept_text": {"type": ["string", "null"]},
    "target_format": {"type": "string", "enum": ["ANY", "FILM", "SERIES", "LIMITED_SERIES"], "default": "ANY"},
    "target_genre": {"type": ["string", "null"]},
    "preferred_ideation_mode": {"type": "string", "enum": ["AUTO", "character_first", "relationship_first", "world_first", "situation_first", "genre_first", "scene_first", "ending_first", "truth_first", "discovery_first", "title_first"], "default": "AUTO"},
    "anchor_strength": {"type": "string", "enum": ["LOOSE", "CENTERED", "STRICT"], "default": "CENTERED"},
    "human_notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
