{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Never Coming Soon Ideation Director Plan",
  "type": "object",
  "required": ["target_seed_count", "mode_plan", "catalog_observations", "creative_permission"],
  "properties": {
    "target_seed_count": {"type": "integer", "minimum": 1},
    "mode_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mode", "count", "provocation"],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "character_first",
              "relationship_first",
              "world_first",
              "situation_first",
              "genre_first",
              "scene_first",
              "ending_first",
              "truth_first",
              "discovery_first",
              "title_first"
            ]
          },
          "count": {"type": "integer", "minimum": 1},
          "provocation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "catalog_observations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "creative_permission": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
