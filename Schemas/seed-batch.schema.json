{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Never Coming Soon Seed Batch",
  "type": "object",
  "required": ["seeds"],
  "properties": {
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "working_title",
          "format",
          "genre",
          "premise",
          "creative_kernel",
          "why_exciting",
          "initial_possibilities",
          "creative_tags",
          "normalized_signature"
        ],
        "properties": {
          "working_title": {"type": "string"},
          "format": {"type": "string", "enum": ["FILM", "SERIES", "LIMITED_SERIES"]},
          "genre": {"type": "string"},
          "premise": {"type": "string"},
          "creative_kernel": {"type": "string"},
          "why_exciting": {"type": "string"},
          "initial_possibilities": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {"type": "string"}
          },
          "creative_tags": {
            "type": "object",
            "properties": {
              "secondary_genre": {"type": ["string", "null"]},
              "arena": {"type": ["string", "null"]},
              "tone": {"type": "array", "items": {"type": "string"}},
              "era": {"type": ["string", "null"]},
              "setting": {"type": ["string", "null"]},
              "scale": {"type": ["string", "null"]},
              "audience": {"type": ["string", "null"]},
              "narrative_engine": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "normalized_signature": {
            "type": "object",
            "required": ["format", "genre", "arena", "protagonist_archetype", "central_relationship", "core_situation", "story_engine", "setting"],
            "properties": {
              "format": {"type": ["string", "null"]},
              "genre": {"type": ["string", "null"]},
              "arena": {"type": ["string", "null"]},
              "protagonist_archetype": {"type": ["string", "null"]},
              "central_relationship": {"type": ["string", "null"]},
              "core_situation": {"type": ["string", "null"]},
              "story_engine": {"type": ["string", "null"]},
              "setting": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
