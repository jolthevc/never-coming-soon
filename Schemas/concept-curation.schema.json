{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Never Coming Soon Concept Curation",
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "idea_id",
          "status",
          "scorecard"
        ],
        "properties": {
          "idea_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "DEVELOP",
              "PROMISING",
              "HOLD"
            ]
          },
          "scorecard": {
            "type": "object",
            "required": [
              "desire",
              "fertility",
              "human_pull",
              "distinctive_spark",
              "emotional_genre_promise",
              "overall_potential",
              "would_develop",
              "notes"
            ],
            "properties": {
              "desire": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "fertility": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "human_pull": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "distinctive_spark": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "emotional_genre_promise": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "overall_potential": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "would_develop": {
                "type": "string",
                "enum": [
                  "YES",
                  "MAYBE",
                  "NO"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "DEVELOP"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "scorecard": {
                  "properties": {
                    "would_develop": {
                      "const": "YES"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PROMISING"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "scorecard": {
                  "properties": {
                    "would_develop": {
                      "enum": [
                        "YES",
                        "MAYBE"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "HOLD"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "scorecard": {
                  "properties": {
                    "would_develop": {
                      "enum": [
                        "MAYBE",
                        "NO"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
